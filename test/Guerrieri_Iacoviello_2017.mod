	uh(0) = ((1 - EH) / (1 - BETA * EH)) * JEI * ((az(0) * aj(0)) / ((1 - h1(0)) - EH * (1 - h1(-1))) - (az(1) * BETA * EH * aj(1)) / ((1 - h1(1)) - EH * (1 - h1(0))));

